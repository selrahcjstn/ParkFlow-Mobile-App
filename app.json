{
  "expo": {
    "name": "parkflow",
    "slug": "parkflow",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./assets/images/parkflow.png",
    "scheme": [
      "parkflow",
      "msauth"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noremi.parkflow",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.noremi.parkflow",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/parkflow.png",
        "backgroundImage": "./assets/images/parkflow.png",
        "monochromeImage": "./assets/images/parkflow.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/parkflow.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/parkflow.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ParkFlow to access your camera to scan QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ParkFlow to access your photos.",
          "cameraPermission": "Allow ParkFlow to access your camera to take visitor document and vehicle photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/33896bf4-c739-45a4-a2df-ac38d4289e68",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "33896bf4-c739-45a4-a2df-ac38d4289e68"
      }
    }
  }
}
